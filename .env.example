# Server
PORT=4000
MONGODB_URI=mongodb://localhost:27017/gsp
NODE_ENV=development

# Demo: expose human-readable hints in API responses (false in production)
EXPOSE_ERROR_HINTS=true

# AI — mock works with no keys
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudinary (optional — add your free tier credentials)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client
NEXT_PUBLIC_API_URL=http://localhost:4000

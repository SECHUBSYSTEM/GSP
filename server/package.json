{
  "name": "@gsp/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "test": "vitest run ../tests/workflow && tsx ../tests/api/smoke.run.ts",
    "test:unit": "vitest run ../tests/workflow",
    "test:unit:coverage": "vitest run ../tests/workflow --coverage",
    "test:smoke": "tsx ../tests/api/smoke.run.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "info": {
    "name": "GSP Workflow API",
    "description": "StudyNow GSP take-home assessment — import and run Setup folder first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "agentUserId", "value": "" },
    { "key": "counsellorUserId", "value": "" },
    { "key": "qaUserId", "value": "" },
    { "key": "admissionUserId", "value": "" },
    { "key": "applicationId", "value": "" }
  ],
  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "Create Agent user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('agentUserId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Agent\",\n  \"email\": \"demo.agent@partner.com\",\n  \"role\": \"agent\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create Counsellor user",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('counsellorUserId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Counsellor\",\n  \"email\": \"demo.counsellor@studynow.com\",\n  \"role\": \"counsellor\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create QA Officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('qaUserId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo QA\",\n  \"email\": \"demo.qa@studynow.com\",\n  \"role\": \"qa_officer\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        },
        {
          "name": "Create Admission Officer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('admissionUserId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Admission\",\n  \"email\": \"demo.admission@studynow.com\",\n  \"role\": \"admission_officer\"\n}"
            },
            "url": "{{baseUrl}}/users"
          }
        }
      ]
    },
    {
      "name": "Agent flow",
      "item": [
        {
          "name": "Create application",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('applicationId', pm.response.json().data.id);",
                  "pm.test('Agent view hides internal stage', () => {",
                  "  pm.expect(pm.response.json().data.stage).to.be.undefined;",
                  "  pm.expect(pm.response.json().data.statusLabel).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{agentUserId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student\": { \"name\": \"Jane Doe\", \"email\": \"jane@example.com\", \"nationality\": \"Nigeria\" },\n  \"course\": { \"name\": \"MSc Data Science\", \"university\": \"University of Manchester\", \"intake\": \"Sep 2026\" }\n}"
            },
            "url": "{{baseUrl}}/applications"
          }
        },
        {
          "name": "Agent blocked from transition (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('Has readable hint', () => pm.expect(pm.response.json().error.hint).to.be.a('string');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{agentUserId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetStage\": \"qa_review\"\n}"
            },
            "url": "{{baseUrl}}/applications/{{applicationId}}/transition"
          }
        }
      ]
    },
    {
      "name": "Internal workflow",
      "item": [
        {
          "name": "Counsellor → QA Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{counsellorUserId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"targetStage\": \"qa_review\"\n}" },
            "url": "{{baseUrl}}/applications/{{applicationId}}/transition"
          }
        },
        {
          "name": "QA blocked → App Review (missing docs)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Blocked with 422', () => pm.response.to.have.status(422));",
                  "pm.test('Rule named', () => pm.expect(pm.response.json().error.rule).to.eql('allRequiredDocumentsUploaded'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{qaUserId}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"targetStage\": \"app_review\"\n}" },
            "url": "{{baseUrl}}/applications/{{applicationId}}/transition"
          }
        },
        {
          "name": "Get AI assessment",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-User-Id", "value": "{{qaUserId}}" }],
            "url": "{{baseUrl}}/applications/{{applicationId}}/ai-assessment"
          }
        }
      ]
    }
  ]
}
